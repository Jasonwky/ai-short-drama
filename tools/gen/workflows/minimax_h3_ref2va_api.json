{
  "1": {
    "class_type": "UNETLoader",
    "inputs": { "unet_name": "minimax_h3_ref2va_pruned_fp8_scaled.safetensors", "weight_dtype": "default" },
    "_meta": { "title": "H3 ref2va 主模型" }
  },
  "2": {
    "class_type": "LoraLoaderModelOnly",
    "inputs": {
      "model": ["1", 0],
      "lora_name": "minimax_h3_ref2va_pdd_acc_8step_comfyui.safetensors",
      "strength_model": 1.0
    },
    "_meta": { "title": "PDD 8 步加速 LoRA(阿里 PAI 官方,明确支持 ref2va)" }
  },
  "3": {
    "class_type": "PrimitiveBoolean",
    "inputs": { "value": false },
    "_meta": { "title": "开关:false=20步基线 / true=8步加速(CFG 已蒸馏进权重)" }
  },
  "4": {
    "class_type": "ComfySwitchNode",
    "inputs": { "switch": ["3", 0], "on_false": ["1", 0], "on_true": ["2", 0] },
    "_meta": { "title": "选 model" }
  },
  "5": {
    "class_type": "CLIPLoader",
    "inputs": {
      "clip_name": "qwen3vl_32b_minimax_h3_int8_convrot.safetensors",
      "type": "minimax",
      "device": "default"
    },
    "_meta": { "title": "H3 文本编码器(Qwen3-VL 32B int8)" }
  },
  "6": {
    "class_type": "VAELoader",
    "inputs": { "vae_name": "minimax_h3_video_vae_fp16.safetensors" },
    "_meta": { "title": "视频 VAE —— 不接则参考图只作用于文本编码器" }
  },
  "7": {
    "class_type": "VAELoader",
    "inputs": { "vae_name": "minimax_h3_audio_vae_fp32.safetensors" },
    "_meta": { "title": "音频 VAE —— 不接则参考音频形同虚设(闸门 0-4 的前提)" }
  },
  "8": { "class_type": "LoadImage", "inputs": { "image": "ref1.png" }, "_meta": { "title": "参考图 1 → <Picture 1>" } },
  "9": { "class_type": "LoadImage", "inputs": { "image": "ref2.png" }, "_meta": { "title": "参考图 2 → <Picture 2>" } },
  "10": { "class_type": "LoadImage", "inputs": { "image": "ref3.png" }, "_meta": { "title": "参考图 3 → <Picture 3>" } },
  "11": {
    "class_type": "LoadAudio",
    "inputs": { "audio": "voice_ref.wav" },
    "_meta": { "title": "参考音频 → <Audio 1>,角色音色锁定(闸门 0-4)" }
  },
  "12": {
    "class_type": "MiniMaxH3ReferenceToVideo",
    "inputs": {
      "clip": ["5", 0],
      "prompt": "PROMPT_PLACEHOLDER",
      "width": 768,
      "height": 1344,
      "length": 124,
      "ref_image_size": "match",
      "vae": ["6", 0],
      "audio_vae": ["7", 0],
      "ref_images.ref_image_0": ["8", 0],
      "ref_images.ref_image_1": ["9", 0],
      "ref_images.ref_image_2": ["10", 0],
      "ref_audios.ref_audio_0": ["11", 0]
    },
    "_meta": {
      "title": "ref2va —— 竖屏 768x1344;length 必须落在 17k+5 网格且在训练区间 124..362 内(由调用方算好传入)"
    }
  },
  "13": {
    "class_type": "BasicGuider",
    "inputs": { "model": ["4", 0], "conditioning": ["12", 0] },
    "_meta": { "title": "引导器(加速档 CFG 已蒸馏进权重,故不用 CFGGuider)" }
  },
  "14": {
    "class_type": "KSamplerSelect",
    "inputs": { "sampler_name": "res_multistep" },
    "_meta": { "title": "采样器(沿用已出片工作流的选择)" }
  },
  "15": { "class_type": "PrimitiveInt", "inputs": { "value": 20 }, "_meta": { "title": "基线步数" } },
  "16": { "class_type": "PrimitiveInt", "inputs": { "value": 8 }, "_meta": { "title": "加速步数(PDD 8 步;多于 8 不会更好)" } },
  "17": {
    "class_type": "ComfySwitchNode",
    "inputs": { "switch": ["3", 0], "on_false": ["15", 0], "on_true": ["16", 0] },
    "_meta": { "title": "选 steps" }
  },
  "18": {
    "class_type": "BasicScheduler",
    "inputs": { "model": ["4", 0], "scheduler": "simple", "steps": ["17", 0], "denoise": 1.0 },
    "_meta": { "title": "调度" }
  },
  "19": {
    "class_type": "RandomNoise",
    "inputs": { "noise_seed": 0 },
    "_meta": { "title": "噪声种子 —— 由调用方写入,不可随机" }
  },
  "20": {
    "class_type": "SamplerCustomAdvanced",
    "inputs": {
      "noise": ["19", 0],
      "guider": ["13", 0],
      "sampler": ["14", 0],
      "sigmas": ["18", 0],
      "latent_image": ["12", 1]
    },
    "_meta": { "title": "采样(输入 latent 是 ref2va 节点的第 2 个输出:视频+音频联合 latent)" }
  },
  "21": {
    "class_type": "VAEDecode",
    "inputs": { "samples": ["20", 0], "vae": ["6", 0] },
    "_meta": { "title": "解码视频" }
  },
  "22": {
    "class_type": "VAEDecodeAudio",
    "inputs": { "samples": ["20", 0], "vae": ["7", 0] },
    "_meta": { "title": "解码音频 —— H3 是视频音频联合生成,口型天然同步" }
  },
  "23": {
    "class_type": "CreateVideo",
    "inputs": { "images": ["21", 0], "fps": 24.0, "audio": ["22", 0], "bit_depth": 8 },
    "_meta": { "title": "合成带音轨的视频" }
  },
  "24": {
    "class_type": "SaveVideo",
    "inputs": { "video": ["23", 0], "filename_prefix": "shortdrama/h3", "format": "auto", "codec": "auto" },
    "_meta": { "title": "存片" }
  }
}
